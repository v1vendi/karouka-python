+// time under the same bytes), in themselves, the records inside them or the nested display lists they paint.
+static bool records_draw_live_embedder_content(DisplayListResourceStorage const& resource_storage, ReadonlyBytes records)
+{
+    bool draws = false;
+    DisplayList::for_each_command_header(records, [&](DisplayListCommandHeader const& header, ReadonlyBytes payload) {
+        if (draws)
+            return;
+        visit_display_list_command(header.command_type, payload, [&](auto const& command) {
+            using Command = RemoveCVReference<decltype(command)>;
+            auto inside = [&](DisplayListDataSpan span) {
+                VERIFY(static_cast<size_t>(span.offset) + span.size <= payload.size());
+                draws = draws || records_draw_live_embedder_content(resource_storage, payload.slice(span.offset, span.size));
+            };
+            if constexpr (IsSame<Command, DrawEmbedderContent>) {
+                draws = command.is_live;
+            } else if constexpr (IsSame<Command, PaintNestedDisplayList>) {
+                draws = resource_storage.has_display_list(command.display_list_id)
+                    && resource_storage.draws_live_embedder_content(resource_storage.display_list(command.display_list_id));
+            } else if constexpr (IsSame<Command, DrawIsolatedGroup>) {
+                inside(command.content);
+                if (command.mask.size != 0)
+                    inside(command.mask);
+            } else if constexpr (IsSame<Command, DrawRepeatedTile>) {
+                inside(command.tile);
+            } else if constexpr (IsSame<Command, DeclareMaskContent>) {
+                inside(command.content);
+            } else if constexpr (requires { command.paint_style; command.paint_kind; }) {
+                if (command.paint_kind == decltype(command.paint_kind)::PaintStyle
+                    && command.paint_style.paint_style_type == DisplayListPaintStyleType::Pattern)
+                    inside(command.paint_style.pattern_tile);
+            }
+        });
+    });
+    return draws;
+}
