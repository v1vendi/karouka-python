+ */
+
+#include <AK/Atomic.h>
+#include <AK/QuickSort.h>
+#include <AK/RefCounted.h>
+#include <AK/Time.h>
+#include <AK/Vector.h>
+#include <LibCore/EventLoop.h>
+#include <LibGC/Cell.h>
+#include <LibGC/Root.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibJS/Runtime/Temporal/Now.h>
+#include <LibJS/Runtime/VM.h>
+#include <math.h>
+#include <pthread.h>
+#include <LibWeb/Bindings/MainThreadVM.h>
+#include <LibWeb/Embedder/HostClock.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/HighResolutionTime/Performance.h>
+
+namespace Web::Embedder {
+
+namespace {
+
+// Ref-counted so that a firing keeps its own entry alive while the timer it fires cancels or moves it.
+struct ScheduledTimer : public RefCounted<ScheduledTimer> {
+    GC::Cell* cell { nullptr };
+    double due { 0 };
+    i32 interval_ms { 0 };
+    bool repeating { false };
+    u64 sequence { 0 };
+    Function<void()> fire;
+};
+
+struct HostClock {
+    bool installed { false };
+    double now { 0 };
+    u64 next_sequence { 0 };
+    bool pass_queued { false };
+    Vector<NonnullRefPtr<ScheduledTimer>> timers;
+    // The wall clock: the Unix time at which the host clock read zero, taken when it was installed, plus its time.
+    i64 wall_offset_ns { 0 };
+};
+
+// The host clock's wall time in nanoseconds since the Unix epoch, for LibJS's Date, which may read it off the main
+// thread (Temporal::set_host_wall_clock).
+Atomic<i64> s_wall_now_ns { 0 };
+
+i64 wall_now_ns()
+{
+    return s_wall_now_ns.load(AK::MemoryOrder::memory_order_relaxed);
+}
+
+// The thread that installed the clock: the main thread, whose event loop it drives.
+pthread_t s_clock_thread;
+
+// The real monotonic time at which the clock was installed, and the host's wall time then: monotonic_now() is the
+// one plus the host's time since. (MonotonicTime has no public constructor from a time.)
+Optional<MonotonicTime> s_monotonic_at_install;
+i64 s_wall_ns_at_install { 0 };
+
+HostClock& clock();
+
+// LibJS's Date clock. On the clock's thread, a read from a window's script is a script read of the host clock
+// (read_host_clock_for_script) through the window's Performance, so a script that waits for Date.now() to move
+// gets there, and Date.now() and performance.now() move together. Any other read is the host's wall time.
+i64 script_wall_now_ns()
+{
+    if (pthread_equal(pthread_self(), s_clock_thread)) {
+        if (auto* realm = Bindings::main_thread_vm().current_realm()) {
+            if (auto* window = Bindings::window_from_global_object(realm->global_object())) {
+                auto now_ms = window->performance()->read_host_clock_for_script();
+                return clock().wall_offset_ns + static_cast<i64>(llround(now_ms * 1e6));
+            }
+        }
+    }
+    return wall_now_ns();
+}
+
+// Never destroyed: a timer finalized during exit()'s static destructors may still cancel itself.
+HostClock& clock()
+{
+    static auto* host_clock = new HostClock;
+    return *host_clock;
+}
+
+Optional<size_t> index_of(GC::Cell const& cell)
+{
+    auto& timers = clock().timers;
+    for (size_t i = 0; i < timers.size(); ++i) {
+        if (timers[i]->cell == &cell)
+            return i;
+    }
+    return {};
+}
+
+// Fires the timers due at the clock's time, earliest deadline first and, at one deadline, in the
+// order they were scheduled. Each fires at most once per pass: a repeating timer that is due again
+// at once (a zero interval, or a host step longer than its interval) fires on the next pass, so a
+// pass always ends.
+void fire_due_timers()
+{
+    auto& host_clock = clock();
+    struct Due {
+        GC::Root<GC::Cell> cell;
+        double due;
+        u64 sequence;
+    };
+    Vector<Due> due;
+    for (auto& timer : host_clock.timers) {
+        if (timer->due <= host_clock.now)
+            due.append({ GC::make_root(timer->cell), timer->due, timer->sequence });
+    }
+    quick_sort(due, [](Due const& a, Due const& b) {
+        return a.due < b.due || (a.due == b.due && a.sequence < b.sequence);
+    });
+
+    for (auto& firing : due) {
+        // A timer an earlier firing of this pass stopped or moved is not due any more (moving it
+        // gives it a new sequence).
+        auto index = host_clock.timers.find_first_index_if([&](auto& timer) { return timer->sequence == firing.sequence; });
+        if (!index.has_value())
+            continue;
+        NonnullRefPtr<ScheduledTimer> timer = host_clock.timers[*index];
+        if (timer->repeating) {
+            // Keeps to its schedule; one that fell behind skips the firings it missed, as a
+            // repeating Core::Timer does.
+            timer->due += max(timer->interval_ms, 0);
+            if (timer->due <= host_clock.now)
+                timer->due = host_clock.now + max(timer->interval_ms, 0);
+        } else {
+            host_clock.timers.remove(*index);
+        }
+        timer->fire();
+    }
+}
+
+}
+
+void install_host_clock(double now_ms)
+{
+    auto& host_clock = clock();
+    if (host_clock.installed) {
+        set_host_clock_time(now_ms);
+        return;
+    }
+    host_clock.installed = true;
+    host_clock.now = now_ms;
+    host_clock.wall_offset_ns = UnixDateTime::now().nanoseconds_since_epoch() - static_cast<i64>(llround(now_ms * 1e6));
+    // A whole number of milliseconds, so that where Date.now() (which floors to a millisecond) ticks over against the
+    // host's time is the same on every run: a script that waits on Date.now() takes the same reads each time.
+    host_clock.wall_offset_ns -= host_clock.wall_offset_ns % 1'000'000;
+    s_wall_now_ns.store(host_clock.wall_offset_ns + static_cast<i64>(llround(now_ms * 1e6)));
+    s_clock_thread = pthread_self();
+    s_monotonic_at_install = MonotonicTime::now();
+    s_wall_ns_at_install = s_wall_now_ns.load();
+    JS::Temporal::set_host_wall_clock(script_wall_now_ns);
+}
+
+void set_host_clock_time(double now_ms)
+{
+    auto& host_clock = clock();
+    if (!host_clock.installed)
+        return;
+    host_clock.now = max(host_clock.now, now_ms);
+    s_wall_now_ns.store(host_clock.wall_offset_ns + static_cast<i64>(llround(host_clock.now * 1e6)));
+    fire_due_timers();
+}
+
+Optional<double> next_host_clock_deadline()
+{
+    auto& host_clock = clock();
+    Optional<double> next;
+    for (auto& timer : host_clock.timers) {
+        if (timer->due > host_clock.now && (!next.has_value() || timer->due < *next))
+            next = timer->due;
+    }
+    return next;
+}
+
+bool host_clock_is_installed()
+{
+    return clock().installed;
+}
+
+double host_clock_time()
+{
+    return clock().now;
+}
+
+double host_clock_wall_offset()
+{
+    return static_cast<double>(clock().wall_offset_ns) / 1e6;
+}
+
+double host_clock_wall_time()
+{
+    return static_cast<double>(wall_now_ns()) / 1e6;
+}
+
+MonotonicTime monotonic_now()
+{
+    if (!host_clock_is_installed())
+        return MonotonicTime::now();
+    return *s_monotonic_at_install + AK::Duration::from_nanoseconds(wall_now_ns() - s_wall_ns_at_install);
+}
+
+UnixDateTime unix_now()
+{
+    if (!host_clock_is_installed())
+        return UnixDateTime::now();
+    return UnixDateTime::from_nanoseconds_since_epoch(wall_now_ns());
+}
+
+double read_host_clock_for_script(double& next_read)
+{
+    auto now_ms = max(clock().now, next_read);
+    next_read = now_ms + script_read_step_ms;
+    return now_ms;
+}
+
+void schedule_on_host_clock(GC::Cell& cell, i32 interval_ms, bool repeating, Function<void()> fire)
+{
+    auto& host_clock = clock();
+    cancel_on_host_clock(cell);
+    auto timer = adopt_ref(*new ScheduledTimer);
+    timer->cell = &cell;
+    timer->due = host_clock.now + max(interval_ms, 0);
+    timer->interval_ms = interval_ms;
+    timer->repeating = repeating;
+    timer->sequence = host_clock.next_sequence++;
+    timer->fire = move(fire);
+    host_clock.timers.append(move(timer));
+
+    // A timer due now fires on the event loop's next turn, as a zero-delay Core::Timer would; one due
+    // later waits for the host to move the clock.
+    if (interval_ms <= 0 && !host_clock.pass_queued) {
+        host_clock.pass_queued = true;
+        Core::deferred_invoke([] {
+            clock().pass_queued = false;
+            fire_due_timers();
+        });
+    }
+}
+
+void cancel_on_host_clock(GC::Cell const& cell)
+{
+    if (auto index = index_of(cell); index.has_value())
+        clock().timers.remove(*index);
+}
+
+bool is_scheduled_on_host_clock(GC::Cell const& cell)
+{
+    return index_of(cell).has_value();
+}
+
+}
diff --git a/Libraries/LibWeb/Embedder/HostClock.h b/Libraries/LibWeb/Embedder/HostClock.h
new file mode 100644
index 0000000000..7dd4ac1502
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/HostClock.h
@@ -0,0 +1,84 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Function.h>
+#include <AK/Optional.h>
+#include <AK/Time.h>
+#include <AK/Types.h>
+#include <LibGC/Forward.h>
+#include <LibWeb/Export.h>
+
+namespace Web::Embedder {
+
+// A clock the embedder drives, in place of the shared monotonic clock. Once installed, LibWeb's
+// unsafe shared current time (HighResolutionTime::unsafe_shared_current_time, which performance.now(),
+// time origins, timer deadlines and the animation timeline read) is the host's time, and it moves
+// only when the host sets it: it stands still between two calls. EventLoop::rendering_opportunity
+// takes the host's frame time as it is, without clamping it to the real clock, and HTML::Timer runs
+// on this clock instead of a Core::Timer: a timer fires when the host's time reaches its deadline,
+// not when real time does. So a host that steps its time by a fixed amount per frame gets the same
+// frames whatever the frames cost. It is for the main thread's event loop; nothing else may read it.
+//
+// The wall clock moves with it: once installed, Date (Date.now(), new Date(); through
+// JS::Temporal::set_host_wall_clock), Temporal.Now and the wall clock's unsafe current time read the
+// Unix time at which the clock was installed plus the host time since, so Date.now() moves by what
+// performance.now() moves by, and performance.timeOrigin holds still.
+//
+// A script's reads of it take time. Within a task the host clock stands still, so a script that waits
+// for performance.now() or Date.now() to move would spin forever. Each read a window's script makes
+// (Performance::now, and on the main thread Date.now(), new Date() and Temporal.Now through the
+// window's Performance) returns at least script_read_step_ms after the previous read in the same
+// window, and never less than the host clock's time: a script's time is the host's, plus one step per
+// read it made since the host's time passed it. The step is fixed, so a busy wait ends after the same
+// number of reads on every run. Only script reads step: LibWeb's own reads (event timestamps, the
+// animation timeline, timers) stay on the host's time, which can then lag what a page read until the
+// host's time catches up (a 100 ms busy wait reads 100 ms ahead of the next six 16.67 ms frames).
+//
+// Installs the clock at now_ms (milliseconds on the host's monotonic clock). Installing it again only
+// sets its time. There is no uninstall: time origins and deadlines taken on one clock mean nothing on
+// the other.
+WEB_API void install_host_clock(double now_ms);
+
+// Moves the host clock to now_ms (never back: an earlier time is ignored), then fires every timer
+// due by then, in deadline order. Firing a timer queues its task; the event loop runs it.
+WEB_API void set_host_clock_time(double now_ms);
+
+// The earliest deadline after the clock's time of a timer scheduled on it, if any: the host moves the
+// clock there (set_host_clock_time) for the timer to fire at its own time, not at the host's next
+// step after it. A timer due at the clock's time fires on the event loop's next turn and is not one.
+WEB_API Optional<double> next_host_clock_deadline();
+
+bool host_clock_is_installed();
+double host_clock_time();
+// The Unix time, in milliseconds, at which the host clock reads zero, and the Unix time it reads now.
+double host_clock_wall_offset();
+double host_clock_wall_time();
+
+// "Now" for LibWeb's own readers of the monotonic and Unix clocks (a caret's blink cycle, a main-thread smooth
+// scroll's steps, a wheel gesture's latch, media and FileReader event throttles, File.lastModified, cookie expiry):
+// the host clock and its wall clock once one is installed, so what they decide comes out the same however long the
+// host's frames take; the real clocks otherwise. Safe off the main thread (a worker's File): both read the host's
+// wall time, which is atomic. A MonotonicTime taken on one clock means nothing on the other, as with deadlines.
+WEB_API MonotonicTime monotonic_now();
+WEB_API UnixDateTime unix_now();
+
+// The step, in milliseconds, each script read of the host clock takes (see above).
+constexpr double script_read_step_ms = 0.001;
+
+// A script's read of the host clock, for the reader whose next read may come no earlier than next_read
+// (Performance keeps it per window; it starts at zero): the later of the host clock's time and
+// next_read. Moves next_read one step past the time returned.
+double read_host_clock_for_script(double& next_read);
+
+// For HTML::Timer. A timer is scheduled at most once; scheduling it again moves it. `cell` is kept
+// rooted while a firing is under way, so that the firing of another timer can't collect it.
+void schedule_on_host_clock(GC::Cell& cell, i32 interval_ms, bool repeating, Function<void()> fire);
+void cancel_on_host_clock(GC::Cell const& cell);
+bool is_scheduled_on_host_clock(GC::Cell const& cell);
+
+}
diff --git a/Libraries/LibWeb/Embedder/InPlaceLoad.cpp b/Libraries/LibWeb/Embedder/InPlaceLoad.cpp
new file mode 100644
index 0000000000..7e55881d02
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/InPlaceLoad.cpp
@@ -0,0 +1,82 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibHTTP/HeaderList.h>
+#include <LibURL/URL.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/DOM/DocumentLoading.h>
+#include <LibWeb/Embedder/InPlaceLoad.h>
+#include <LibWeb/Fetch/Infrastructure/HTTP/Bodies.h>
+#include <LibWeb/Fetch/Infrastructure/HTTP/Responses.h>
+#include <LibWeb/HTML/DocumentState.h>
+#include <LibWeb/HTML/LocalTraversableNavigable.h>
+#include <LibWeb/HTML/NavigationParams.h>
+#include <LibWeb/HTML/PolicyContainers.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/HTML/SessionHistoryEntry.h>
+
+namespace Web::Embedder {
+
+GC::Ptr<DOM::Document> load_html_in_place(HTML::LocalTraversableNavigable& traversable, URL::URL const& url, ReadonlyBytes html, HTML::CrossProcessId cross_process_id)
+{
+    auto old_document = traversable.active_document();
+    if (!old_document)
+        return nullptr;
+    auto& realm = HTML::relevant_realm(*old_document);
+    auto& heap = GC::Heap::the();
+
+    auto response = Fetch::Infrastructure::Response::create(realm.vm());
+    response->url_list().append(url);
+    response->set_header_list(HTTP::HeaderList::create({ { "Content-Type"sv, "text/html"sv } }));
+    response->set_body(Fetch::Infrastructure::byte_sequence_as_body(realm, html));
+
+    auto origin = url.origin();
+    auto coop = HTML::OpenerPolicy {};
+    HTML::OpenerPolicyEnforcementResult coop_enforcement_result {
+        .url = url,
+        .origin = origin,
+        .opener_policy = coop,
+    };
+    // Same arguments as create_document_for_inline_content(), with the page's own origin.
+    auto navigation_params = heap.allocate<HTML::NavigationParams>(
+        OptionalNone {},
+        traversable,
+        nullptr,
+        response,
+        nullptr,
+        nullptr,
+        move(coop_enforcement_result),
+        nullptr,
+        origin,
+        heap.allocate<HTML::PolicyContainer>(heap),
+        HTML::SandboxingFlagSet {},
+        ReferrerPolicy::ReferrerPolicy::EmptyString,
+        move(coop),
+        Bindings::NavigationTimingType::Navigate,
+        OptionalNone {},
+        HTML::UserNavigationInvolvement::None);
+
+    auto document = load_document(*navigation_params, html);
+    if (!document)
+        return nullptr;
+
+    auto document_state = HTML::DocumentState::create(cross_process_id);
+    document_state->set_initiator_origin(origin);
+    document_state->set_origin(origin);
+    document_state->set_ever_populated(true);
+    auto entry = HTML::SessionHistoryEntry::create();
+    entry->set_url(url);
+    entry->set_document_state(document_state);
+
+    traversable.activate_history_entry(entry, *document);
+
+    // What applying the history step does for a new document: set its latest entry, scroll to the
+    // fragment, and let scripts run, which starts the parser.
+    document->update_for_history_step_application(entry, false, 1, 0, Bindings::NavigationType::Push, Vector<NonnullRefPtr<HTML::SessionHistoryEntry>> { entry });
+    return document;
+}
+
+}
diff --git a/Libraries/LibWeb/Embedder/InPlaceLoad.h b/Libraries/LibWeb/Embedder/InPlaceLoad.h
