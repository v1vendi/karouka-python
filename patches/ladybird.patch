+# karouka: embedders that render pages into textures can leave out browser-only Web API families.
+# Each Embedder/Prune/<Family>.cmake appends its directory name to LIBWEB_PRUNED_FAMILIES. The
+# family's sources and IDL files are then not built, and the call sites outside the family are
+# guarded by LIBWEB_PRUNE_<FAMILY>. That definition is PUBLIC: some guards change the layout of
+# classes (Navigator, WindowOrWorkerGlobalScopeMixin) whose headers embedders include. The bindings
+# generator drops the members of other interfaces that use a pruned family's definitions
+# (navigator.serial, Window.cookieStore, ...). A family with files outside its directory filters
+# them from SOURCES itself and lists their IDL in LIBWEB_PRUNED_IDL. Services that use a pruned family (WebContent uses WebDriver, for one) do not
+# build with this option on.
+# The LIBWEB_PRUNE_WEB_APIS option is declared in the top-level CMakeLists.txt, before project(), so
+# that vcpkg leaves the browser's dependencies out too.
+set(LIBWEB_PRUNED_FAMILIES)
+set(LIBWEB_PRUNED_IDL)
+if (LIBWEB_PRUNE_WEB_APIS)
+    file(GLOB libweb_prune_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/Embedder/Prune/*.cmake")
+    foreach (libweb_prune_file IN LISTS libweb_prune_files)
+        include("${libweb_prune_file}")
+    endforeach()
+    foreach (libweb_pruned_family IN LISTS LIBWEB_PRUNED_FAMILIES)
+        list(FILTER SOURCES EXCLUDE REGEX "^${libweb_pruned_family}/")
+    endforeach()
+endif()
