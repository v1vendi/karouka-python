new file mode 100644
index 0000000000..a63130e45e
--- /dev/null
+++ b/Libraries/LibMediaClient/ClientPtr.h
@@ -0,0 +1,38 @@
+/*
+ * karouka: how the remote media objects hold their connection to the MediaServer.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Assertions.h>
+#include <AK/RefPtr.h>
+#include <LibMediaClient/Forward.h>
+
+namespace MediaClient {
+
+#ifdef LIBMEDIACLIENT_NO_SERVER
+// Built without a MediaServer (LADYBIRD_MEDIA_STUB): Client::acquire() always fails, so no Client is ever created and
+// a remote object's client is always null. Saying so in the type lets the compiler drop every message send behind
+// it, and with them the MediaServer and MediaClient IPC endpoints.
+class ClientPtr {
+public:
+    ClientPtr() = default;
+    ClientPtr(nullptr_t) { }
+    ClientPtr(RefPtr<Client> const& client) { VERIFY(!client); }
+
+    ClientPtr& operator=(nullptr_t) { return *this; }
+
+    explicit operator bool() const { return false; }
+    bool operator!() const { return true; }
+    bool operator==(nullptr_t) const { return true; }
+
+    Client* ptr() const { return nullptr; }
+    [[noreturn]] Client* operator->() const { VERIFY_NOT_REACHED(); }
+};
+#else
+using ClientPtr = RefPtr<Client>;
+#endif
+
+}
