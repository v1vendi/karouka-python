index 0000000000..ee8702673b
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/ScriptTypes.cpp
@@ -0,0 +1,120 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibCore/ImmutableBytes.h>
+#include <LibTextCodec/Decoder.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/Embedder/ScriptTypes.h>
+#include <LibWeb/Fetch/Fetching/Fetching.h>
+#include <LibWeb/Fetch/Infrastructure/FetchAlgorithms.h>
+#include <LibWeb/Fetch/Infrastructure/HTTP/Requests.h>
+#include <LibWeb/Fetch/Infrastructure/HTTP/Responses.h>
+#include <LibWeb/HTML/HTMLScriptElement.h>
+#include <LibWeb/HTML/PotentialCORSRequest.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWebCommon/Fetch/Infrastructure/HTTP/Statuses.h>
+#include <LibWebCommon/MimeSniff/MimeType.h>
+
+namespace Web::Embedder {
+
+GC_DEFINE_ALLOCATOR(EmbedderScript);
+
+static ScriptTypeHandler* s_handler = nullptr;
+
+ScriptTypeHandler::~ScriptTypeHandler() = default;
+
+void set_script_type_handler(ScriptTypeHandler* handler)
+{
+    s_handler = handler;
+}
+
+EmbedderScript::EmbedderScript(String mime_essence, String source_text, URL::URL url, size_t line, HTML::EnvironmentSettingsObject& settings, URL::URL base_url)
+    : Script(move(base_url), url.to_byte_string(), settings)
+    , m_mime_essence(move(mime_essence))
+    , m_source_text(move(source_text))
+    , m_url(move(url))
+    , m_line(line)
+{
+}
+
+EmbedderScript::~EmbedderScript() = default;
+
+GC::Ref<EmbedderScript> EmbedderScript::create(String mime_essence, String source_text, URL::URL url, size_t line, HTML::EnvironmentSettingsObject& settings, URL::URL base_url)
+{
+    return settings.realm().heap().allocate<EmbedderScript>(move(mime_essence), move(source_text), move(url), line, settings, move(base_url));
+}
+
+Optional<String> embedder_script_type_essence(DOM::Document const& document, Utf16View script_block_type)
+{
+    if (!s_handler)
+        return {};
+    auto mime_type = MimeSniff::MimeType::parse(script_block_type);
+    if (!mime_type.has_value())
+        return {};
+    auto const& essence = mime_type->essence();
+    if (!s_handler->handles_script_type(document, essence))
+        return {};
+    return essence;
+}
+
+GC::Ref<EmbedderScript> create_inline_embedder_script(HTML::HTMLScriptElement& element, String mime_essence, Utf16View source_text, size_t line)
+{
+    auto& document = element.document();
+    return EmbedderScript::create(move(mime_essence), source_text.to_utf8_but_should_be_ported_to_utf16(), document.url(), line, document.relevant_settings_object(), document.base_url());
+}
+
+void fetch_embedder_script(HTML::HTMLScriptElement& element, String mime_essence, URL::URL const& url, HTML::EnvironmentSettingsObject& settings_object, HTML::ScriptFetchOptions options, HTML::OnFetchScriptComplete on_complete)
+{
+    // As fetch a classic script, with the classic script CORS setting "no-cors".
+    auto request = HTML::create_potential_CORS_request(url, Fetch::Infrastructure::Request::Destination::Script, HTML::CORSSettingAttribute::NoCORS);
+    request->set_client(&settings_object);
+    request->set_initiator_type(Fetch::Infrastructure::Request::InitiatorType::Script);
+    request->set_cryptographic_nonce_metadata(options.cryptographic_nonce);
+    request->set_integrity_metadata(options.integrity_metadata);
+    request->set_parser_metadata(options.parser_metadata);
+    request->set_referrer_policy(options.referrer_policy);
+    request->set_render_blocking(options.render_blocking);
+    request->set_priority(options.fetch_priority);
+
+    Fetch::Infrastructure::FetchAlgorithms::Input fetch_algorithms_input {};
+    fetch_algorithms_input.process_response_consume_body = [&settings_object, mime_essence = move(mime_essence), on_complete](auto response, auto body_bytes) {
+        response = response->unsafe_response();
+        if (!body_bytes.template has<Core::ImmutableBytes>() || !Fetch::Infrastructure::is_ok_status(response->status())) {
+            on_complete->function()(nullptr);
+            return;
+        }
+        auto decoder = TextCodec::decoder_for("utf-8"sv);
+        VERIFY(decoder.has_value());
+        auto source_text = TextCodec::convert_input_to_utf8_using_given_decoder_unless_there_is_a_byte_order_mark(*decoder, StringView { body_bytes.template get<Core::ImmutableBytes>().bytes() });
+        if (source_text.is_error()) {
+            on_complete->function()(nullptr);
+            return;
+        }
+        auto response_url = response->url().value_or({});
+        // The script's base URL is the response's URL, as a classic script's.
+        on_complete->function()(EmbedderScript::create(mime_essence, source_text.release_value(), response_url, 1, settings_object, response_url));
+    };
+
+    Fetch::Fetching::fetch(HTML::relevant_realm(element), request, Fetch::Infrastructure::FetchAlgorithms::create(move(fetch_algorithms_input)));
+}
+
+bool run_embedder_script(HTML::HTMLScriptElement& element, EmbedderScript& script)
+{
+    // A handler unset since the script was prepared: nothing ran it.
+    if (!s_handler)
+        return false;
+
+    // As run a classic script: check if we can run script, prepare to run script, run, clean up.
+    auto& settings = script.settings_object();
+    if (HTML::can_run_script(settings) == HTML::RunScriptDecision::DoNotRun)
+        return true;
+    HTML::prepare_to_run_script(settings);
+    bool succeeded = s_handler->run_script(element, script);
+    HTML::clean_up_after_running_script(settings);
+    return succeeded;
+}
+
+}
diff --git a/Libraries/LibWeb/Embedder/ScriptTypes.h b/Libraries/LibWeb/Embedder/ScriptTypes.h
new file mode 100644
index 0000000000..1d2f230d76
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/ScriptTypes.h
@@ -0,0 +1,75 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/String.h>
+#include <AK/Utf16View.h>
+#include <LibURL/URL.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+#include <LibWeb/HTML/Scripting/Fetching.h>
+#include <LibWeb/HTML/Scripting/Script.h>
+
+namespace Web::Embedder {
+
+// A script of an embedder script type: its MIME type essence, its source text as UTF-8, the URL
+// it came from (the document's for an inline script, the response's for src=) and the line its
+// text starts on in that URL's resource (an inline script's line in the document, 1 for src=).
+class WEB_API EmbedderScript final : public HTML::Script {
+    GC_CELL(EmbedderScript, HTML::Script);
+    GC_DECLARE_ALLOCATOR(EmbedderScript);
+
+public:
+    virtual ~EmbedderScript() override;
+
+    String const& mime_essence() const { return m_mime_essence; }
+    String const& source_text() const { return m_source_text; }
+    URL::URL const& url() const { return m_url; }
+    size_t line() const { return m_line; }
+
+    static GC::Ref<EmbedderScript> create(String mime_essence, String source_text, URL::URL url, size_t line, HTML::EnvironmentSettingsObject&, URL::URL base_url);
+
+private:
+    EmbedderScript(String mime_essence, String source_text, URL::URL url, size_t line, HTML::EnvironmentSettingsObject&, URL::URL base_url);
+
+    String m_mime_essence;
+    String m_source_text;
+    URL::URL m_url;
+    size_t m_line { 1 };
+};
+
+// Script types the embedder runs itself, such as <script type="text/python">. A script whose type
+// is not a JavaScript MIME type, "module" or "importmap", and whose type's MIME essence the handler
+// accepts for the element's document, follows the classic-script path of "prepare the script
+// element": parser-blocking, or async or defer ordered, src= fetched as a no-cors "script" request
+// (decoded as UTF-8 whatever the charset), currentScript set while it runs, load after a src=
+// script runs. In place of evaluating JavaScript, the element runs the handler; a handler that
+// fails fires error at the element (and no load). The checks of a classic script still apply
+// (nomodule, event/for, CSP for inline text). A type the handler doesn't accept stays ignored.
+class WEB_API ScriptTypeHandler {
+public:
+    virtual ~ScriptTypeHandler();
+
+    // `mime_essence` is the type's MIME essence, lowercase ("text/python" for "Text/Python;v=3").
+    virtual bool handles_script_type(DOM::Document const&, StringView mime_essence) = 0;
+
+    // Runs inside the document's realm, between "prepare to run script" and "clean up after running
+    // script" (a microtask checkpoint follows when no other script is on the stack).
+    // Returns false when the script failed.
+    virtual bool run_script(HTML::HTMLScriptElement&, EmbedderScript const&) = 0;
+};
+
+// One handler for the process; null (the default) leaves every non-JavaScript type ignored.
+WEB_API void set_script_type_handler(ScriptTypeHandler*);
+
+// HTMLScriptElement's side.
+Optional<String> embedder_script_type_essence(DOM::Document const&, Utf16View script_block_type);
+GC::Ref<EmbedderScript> create_inline_embedder_script(HTML::HTMLScriptElement&, String mime_essence, Utf16View source_text, size_t line);
+void fetch_embedder_script(HTML::HTMLScriptElement&, String mime_essence, URL::URL const&, HTML::EnvironmentSettingsObject&, HTML::ScriptFetchOptions, HTML::OnFetchScriptComplete);
+bool run_embedder_script(HTML::HTMLScriptElement&, EmbedderScript&);
+
+}
diff --git a/Libraries/LibWeb/Embedder/ShaderDecodedImageData.cpp b/Libraries/LibWeb/Embedder/ShaderDecodedImageData.cpp
new file mode 100644
index 0000000000..20abc6da7e
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/ShaderDecodedImageData.cpp
@@ -0,0 +1,183 @@
+/*
+ * Copyright (c) 2026, the karouka authors.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/ByteBuffer.h>
+#include <LibCompositing/DisplayList/DisplayListCommand.h>
+#include <LibCompositing/DisplayList/VisualContextTreeTestBuilder.h>
+#include <LibGC/Heap.h>
+#include <LibGC/Weak.h>
+#include <LibWeb/DOM/Element.h>
+#include <LibWeb/Embedder/ShaderDecodedImageData.h>
+#include <LibWeb/Painting/ImagePaint.h>
+#include <math.h>
+
+namespace Web::Embedder {
+
+GC_DEFINE_ALLOCATOR(ShaderDecodedImageData);
+
+namespace {
+
+ShaderContentHook& shader_content_hook()
+{
+    // Never destroyed, like the system that sets it.
+    static auto* hook = new ShaderContentHook;
+    return *hook;
+}
+
+// The tree of a list whose only command draws at its root context: the root alone. (The builder is
+// LibCompositing's way to make a tree outside layout; this one has no nodes added.) Never destroyed:
+// recordings that hold it may outlive static destruction.
+Compositing::AccumulatedVisualContextTree const& root_only_visual_context_tree()
+{
+    static auto* tree = new Compositing::AccumulatedVisualContextTree(Compositing::VisualContextTreeTestBuilder().finish());
+    return *tree;
+}
+
+constexpr int maximum_raster_dimension = 16384;
+
+}
+
+void set_shader_content_hook(ShaderContentHook hook)
+{
+    shader_content_hook() = move(hook);
+}
+
+Optional<Compositing::DisplayListResource> record_shader_display_list(StringView source, CSSPixelSize css_size, float raster_scale, ReadonlySpan<ShaderArgument> arguments)
+{
+    auto& hook = shader_content_hook();
+    if (!hook)
+        return {};
+    if (!(raster_scale > 0))
+        raster_scale = 1;
+    auto content = hook(source, raster_scale, arguments);
+    if (!content.has_value())
+        return {};
+
+    // The list's own pixels, as the painter of a vector image sizes it (vector_image_render_geometry).
+    Gfx::IntSize list_size {
+        clamp(static_cast<int>(lroundf(css_size.width().to_float() * raster_scale)), 1, maximum_raster_dimension),
+        clamp(static_cast<int>(lroundf(css_size.height().to_float() * raster_scale)), 1, maximum_raster_dimension),
+    };
+    Gfx::IntRect bounding_rect { {}, list_size };
+    // A live command (an animated shader) draws at each frame's time, so it is damaged every frame.
+    Compositing::DrawEmbedderContent command { bounding_rect.to_type<float>(), content->content_id, content->is_live };
+
+    // One record in one run, laid out as the Rust recorder writes it.
+    auto payload = Compositing::display_list_object_bytes(command);
+    auto record_size = sizeof(Compositing::DisplayListCommandHeader) + payload.size();
+    auto payload_size = align_up_to(record_size, Compositing::DisplayList::command_alignment) - sizeof(Compositing::DisplayListCommandHeader);
+    Compositing::DisplayListCommandHeader header {
+        .command_type = Compositing::DrawEmbedderContent::command_type,
+        .has_bounding_rect = true,
+        .inline_clip_count = 0,
+        .has_inline_transform = false,
+        .payload_size = static_cast<u32>(payload_size),
+        .bounding_rect = bounding_rect,
+    };
+    ByteBuffer bytes;
+    bytes.append(Compositing::display_list_object_bytes(header));
+    bytes.append(payload);
+    bytes.resize(align_up_to(bytes.size(), Compositing::DisplayList::command_alignment), ByteBuffer::ZeroFillNewElements::Yes);
+    Compositing::DisplayListCommandRun run {};
+    run.offset = 0;
+    run.size = bytes.size();
+    run.ink_bounds = bounding_rect;
+    Vector<Compositing::DisplayListCommandRun> runs;
+    runs.append(run);
+
+    auto const& tree = root_only_visual_context_tree();
+    return Compositing::DisplayListResource { Compositing::DisplayList::create_from_command_bytes(tree, move(bytes), move(runs)), tree };
+}
+
+static HashMap<void const*, GC::Weak<DOM::Element>>& image_client_elements()
+{
+    // Never destroyed: clients may outlive static destruction.
+    static auto& elements = *new HashMap<void const*, GC::Weak<DOM::Element>>;
+    return elements;
+}
+
+void set_image_client_element(void const* client, DOM::Element const* element)
+{
+    if (!element) {
+        image_client_elements().remove(client);
+        return;
+    }
+    image_client_elements().set(client, GC::Weak<DOM::Element> { const_cast<DOM::Element&>(*element) });
+}
+
+DOM::Element const* image_client_element(void const* client)
+{
+    auto element = image_client_elements().get(client);
+    if (!element.has_value())
+        return nullptr;
+    return element->ptr().ptr();
+}
+
+GC::Ref<ShaderDecodedImageData> ShaderDecodedImageData::create(String source, Vector<ShaderArgument> arguments)
+{
+    return GC::Heap::the().allocate<ShaderDecodedImageData>(move(source), move(arguments));
+}
+
+GC::Ref<ShaderDecodedImageData> ShaderDecodedImageData::with_arguments(Vector<ShaderArgument> arguments) const
+{
+    auto image = create(m_source, move(arguments));
+    image->set_is_cors_cross_origin(is_cors_cross_origin());
+    return image;
+}
+
+ShaderDecodedImageData::ShaderDecodedImageData(String source, Vector<ShaderArgument> arguments)
+    : m_source(move(source))
+    , m_arguments(move(arguments))
+    , m_vector_content_identity(next_vector_content_identity())
+{
+}
+
+ShaderDecodedImageData::~ShaderDecodedImageData() = default;
+
+Optional<Compositing::DisplayListResource> ShaderDecodedImageData::record_display_list_at_scale(CSSPixelSize css_size, float raster_scale, CSS::PreferredColorScheme, Compositing::DisplayListResourceStorage&) const
+{
+    RenderKey const key { css_size, raster_scale };
+    if (auto it = m_cached_display_lists.find(key); it != m_cached_display_lists.end())
+        return it->value;
+    auto display_list = record_shader_display_list(m_source.bytes_as_string_view(), css_size, raster_scale, m_arguments);
+    if (!display_list.has_value())
+        return {};
+    // FIXME: Evict least used entries.
+    if (m_cached_display_lists.size() > 10)
+        m_cached_display_lists.remove(m_cached_display_lists.begin());
+    m_cached_display_lists.set(key, *display_list);
+    return display_list;
+}
+
+Optional<Compositing::DisplayListResource> ShaderDecodedImageData::record_display_list(Gfx::IntSize size, CSS::PreferredColorScheme color_scheme, Compositing::DisplayListResourceStorage& resource_storage) const
+{
+    return record_display_list_at_scale(size.to_type<CSSPixels>(), 1, color_scheme, resource_storage);
+}
+
+// As SVGDecodedImageData's for an image without a viewBox: recorded at the destination's CSS size, at
+// the on-screen scale.
+Optional<Painting::ImagePaint> ShaderDecodedImageData::image_paint(Painting::ImagePaintRequest const& request) const
+{
+    auto dst_rect = request.dest_rect;
+    auto css_size = CSSPixelSize {
+        clamp(CSSPixels::nearest_value_for(dst_rect.width()), CSSPixels::smallest_positive_value(), CSSPixels(maximum_raster_dimension)),
+        clamp(CSSPixels::nearest_value_for(dst_rect.height()), CSSPixels::smallest_positive_value(), CSSPixels(maximum_raster_dimension)),
+    };
+    auto raster_scale = max(request.accumulated_scale.width(), request.accumulated_scale.height());
+    if (!(raster_scale > 0))
+        raster_scale = 1;
+    raster_scale = min(raster_scale, static_cast<float>(maximum_raster_dimension) / max(css_size.width(), css_size.height()).to_float());
+    auto display_list = record_display_list_at_scale(css_size, raster_scale, request.color_scheme, request.resource_storage);
+    if (!display_list.has_value())
+        return {};
+    Gfx::IntSize list_size {
+        max(1, static_cast<int>(lroundf(css_size.width().to_float() * raster_scale))),
+        max(1, static_cast<int>(lroundf(css_size.height().to_float() * raster_scale))),
+    };
+    return Painting::ImagePaint { Painting::ImagePaint::NestedDisplayList { .resource = *display_list, .list_size = list_size } };
+}
+
+}
diff --git a/Libraries/LibWeb/Embedder/ShaderDecodedImageData.h b/Libraries/LibWeb/Embedder/ShaderDecodedImageData.h
new file mode 100644
index 0000000000..92bceb04a3
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/ShaderDecodedImageData.h
@@ -0,0 +1,170 @@
+/*
+ * Copyright (c) 2026, the karouka authors.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Array.h>
+#include <AK/Function.h>
+#include <AK/HashMap.h>
+#include <AK/Optional.h>
+#include <AK/String.h>
+#include <AK/Vector.h>
+#include <LibCompositing/DisplayList/DisplayList.h>
+#include <LibCompositing/DisplayList/DisplayListResourceStorage.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+#include <LibWeb/HTML/DecodedImageData.h>
+
+namespace Web::Embedder {
+
+// One `--name value` uniform argument of a shader() image (CSS `shader(<source>, --speed 0.3)`), as
+// computed: name is the dashed ident, values hold what the uniform is set to. A <number> is one value,
+// a <percentage> one value already divided by 100, a <length> one value in CSS px, two numbers two
+// values, and a <color> four: unpremultiplied RGBA in 0-1. element(#id) naming a <canvas> is a Canvas
+// input, which binds a `uniform shader` child to the canvas's presented pixels: canvas_id is its
+// surface in the embedder's canvas surface registry (Compositing::CanvasSurfaceRegistry). One LibWeb
+// won't bind is a RefusedCanvas, and canvas_refusal says why. A value of another kind (a relative color
+// that didn't resolve, say) is Unsupported and sets nothing.
+struct ShaderArgument {
+    enum class Type : u8 {
+        Number,
+        Percentage,
+        Length,
+        NumberPair,
+        Color,
+        Canvas,
+        RefusedCanvas,
+        Unsupported,
+    };
+    // Why element(#id) binds no canvas.
+    enum class CanvasRefusal : u8 {
+        None,
+        // No element has the id.
+        NoElement,
+        // The element isn't a <canvas>.
+        NotACanvas,
+        // The canvas has no 2D context with pixels yet.
+        NoContent,
+        // The canvas isn't origin-clean: script can't read its pixels, so a shader can't either.
+        NotOriginClean,
+        // The canvas is inside the element the image is painted for, which would paint itself.
+        InsidePaintedElement,
+    };
+    String name;
+    Type type { Type::Unsupported };
+    Array<float, 4> values {};
+    u64 canvas_id { 0 };
+    CanvasRefusal canvas_refusal { CanvasRefusal::None };
+    // The id element(#id) names, for a Canvas or RefusedCanvas.
+    String element_id;
+
+    size_t value_count() const
+    {
+        switch (type) {
+        case Type::Number:
+        case Type::Percentage:
+        case Type::Length:
+            return 1;
+        case Type::NumberPair:
+            return 2;
+        case Type::Color:
+            return 4;
+        case Type::Canvas:
+        case Type::RefusedCanvas:
+        case Type::Unsupported:
+            return 0;
+        }
+        VERIFY_NOT_REACHED();
+    }
+    bool operator==(ShaderArgument const&) const = default;
+};
+
+// The element an image style value's client (CSS::ImageStyleValue::Client, by address) paints its images
+// for, so that a shader() canvas input inside it is refused (InsidePaintedElement); null forgets it.
+void set_image_client_element(void const* client, DOM::Element const*);
+DOM::Element const* image_client_element(void const* client);
+
+// The embedder content a shader() image is drawn with: the id its DrawEmbedderContent command names,
+// and whether its pixels change with the frame's time (the shader animates), which makes the command
+// live (DrawEmbedderContent::is_live): drawn at every frame's time and damaged every frame.
+struct ShaderContent {
+    u64 content_id { 0 };
+    bool is_live { false };
+    bool operator==(ShaderContent const&) const = default;
+};
+
+// A shader() image's pixels come from the embedder: LibWeb records one DrawEmbedderContent command
+// (LibCompositing) naming a content id the embedder gave it, and the embedder's player resolves the id
+// to pixels at replay. The hook compiles `source` (the shader's text) and answers the content that
+// paints it into a nested display list recorded at raster_scale device pixels per CSS pixel, filling
+// the command's destination rectangle; nothing when the source paints nothing (it doesn't compile, or
+// it declares what the embedder doesn't supply). It is asked again for each recording the image does
+// not have cached, so it caches by source itself. `arguments` are the image's uniform arguments; the
+// embedder sets the uniforms they name, and a mismatch paints nothing.
+using ShaderContentHook = Function<Optional<ShaderContent>(StringView source, float raster_scale, ReadonlySpan<ShaderArgument> arguments)>;
+WEB_API void set_shader_content_hook(ShaderContentHook);
+
+// The nested display list a shader() image is drawn as: one DrawEmbedderContent over
+// css_size × raster_scale device pixels, or nothing without a hook or content id.
+WEB_API Optional<Compositing::DisplayListResource> record_shader_display_list(StringView source, CSSPixelSize css_size, float raster_scale, ReadonlySpan<ShaderArgument> arguments = {});
+
+// The decoded data of a shader() image: vector content with no natural size, recorded through the
+// hook above. Its recording depends only on its source, its arguments, the size and the scale (a live
+// one's pixels also on the frame's time, which the player supplies). The
+// shared request decodes one per source, without arguments; an image style value with arguments paints
+// a copy bound to them (with_arguments), which is vector content of its own identity.
+class WEB_API ShaderDecodedImageData final : public HTML::DecodedImageData {
+    GC_CELL(ShaderDecodedImageData, HTML::DecodedImageData);
+    GC_DECLARE_ALLOCATOR(ShaderDecodedImageData);
+
+public:
+    static GC::Ref<ShaderDecodedImageData> create(String source, Vector<ShaderArgument> arguments = {});
+    virtual ~ShaderDecodedImageData() override;
+
+    String const& source() const { return m_source; }
+    ReadonlySpan<ShaderArgument> arguments() const { return m_arguments; }
+    GC::Ref<ShaderDecodedImageData> with_arguments(Vector<ShaderArgument>) const;
+
+    virtual bool is_vector_content() const override { return true; }
+    virtual u64 vector_content_identity() const override { return m_vector_content_identity; }
+    virtual Optional<Compositing::DisplayListResource> record_display_list_at_scale(CSSPixelSize, float raster_scale, CSS::PreferredColorScheme, Compositing::DisplayListResourceStorage&) const override;
+    virtual Optional<Compositing::DisplayListResource> record_display_list(Gfx::IntSize, CSS::PreferredColorScheme, Compositing::DisplayListResourceStorage&) const override;
+    virtual Optional<Painting::ImagePaint> image_paint(Painting::ImagePaintRequest const&) const override;
+
+    // No frames: a shader() image is only ever recorded.
+    virtual Optional<Gfx::DecodedImageFrame> default_frame(Gfx::IntSize = {}) const override { return {}; }
+    virtual Optional<Gfx::DecodedImageFrame> current_frame(Gfx::IntSize = {}) const override { return {}; }
+
+    // No natural size or aspect ratio: it fills whatever it is drawn into, as a gradient does.
+    virtual Optional<CSSPixels> intrinsic_width() const override { return {}; }
+    virtual Optional<CSSPixels> intrinsic_height() const override { return {}; }
+    virtual Optional<CSSPixelFraction> intrinsic_aspect_ratio() const override { return {}; }
+
+private:
+    ShaderDecodedImageData(String source, Vector<ShaderArgument> arguments);
+
+    struct RenderKey {
+        CSSPixelSize css_size;
+        float raster_scale { 1 };
+        bool operator==(RenderKey const&) const = default;
+    };
+    struct RenderKeyTraits : public Traits<RenderKey> {
+        static unsigned hash(RenderKey const& key)
+        {
+            return pair_int_hash(pair_int_hash(key.css_size.width().raw_value(), key.css_size.height().raw_value()), bit_cast<u32>(key.raster_scale));
+        }
+        static bool equals(RenderKey const& a, RenderKey const& b) { return a == b; }
+    };
+
+    String m_source;
+    Vector<ShaderArgument> m_arguments;
+    u64 m_vector_content_identity { 0 };
+    // The recordings, so that a nested list painted again is the same list (and the player's raster
+    // of it stays valid).
+    mutable HashMap<RenderKey, Compositing::DisplayListResource, RenderKeyTraits> m_cached_display_lists;
+};
+
+}
