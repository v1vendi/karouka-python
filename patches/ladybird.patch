+bool DisplayListResourceStorage::command_bytes_draw_live_embedder_content(ReadonlyBytes command_bytes, HashTable<u64>& visited_display_lists) const
+{
+    bool draws = false;
+    DisplayList::for_each_command_header(command_bytes, [&](DisplayListCommandHeader const& header, ReadonlyBytes payload) {
+        if (draws)
+            return;
+        visit_display_list_command(header.command_type, payload, [&](auto const& command) {
+            using Command = RemoveCVReference<decltype(command)>;
+            if constexpr (IsSame<Command, DrawEmbedderContent>) {
+                draws = command.is_live;
+            } else if constexpr (IsSame<Command, PaintNestedDisplayList>) {
+                // Nested lists are immutable, so the verdict is kept with the list's cached rasters.
+                if (!has_display_list(command.display_list_id) || visited_display_lists.set(command.display_list_id.value()) != HashSetResult::InsertedNewEntry)
