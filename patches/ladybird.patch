diff --git a/Meta/CMake/vcpkg/overlay-ports/mimalloc/karouka-purge-expired-arenas.patch b/Meta/CMake/vcpkg/overlay-ports/mimalloc/karouka-purge-expired-arenas.patch
new file mode 100644
index 0000000000..cb3c7b7f78
--- /dev/null
+++ b/Meta/CMake/vcpkg/overlay-ports/mimalloc/karouka-purge-expired-arenas.patch
@@ -0,0 +1,45 @@
+karouka: mimalloc 2.2.7's mi_arenas_try_purge returns early when the arenas' purge deadline
+has passed (`arenas_expire < now`; mi_arena_try_purge and upstream v3 test `> now`), so segments
+freed back to an arena were purged only by a forced collect. Purge them once the deadline passes,
+and have a forced purge wait for one running on another thread instead of skipping it.
+
+--- a/src/arena.c
++++ b/src/arena.c
+@@ -621,14 +621,27 @@
+   // check if any arena needs purging?
+   const mi_msecs_t now = _mi_clock_now();
+   mi_msecs_t arenas_expire = mi_atomic_loadi64_acquire(&mi_arenas_purge_expire);
+-  if (!force && (arenas_expire == 0 || arenas_expire < now)) return;
++  // karouka: purge once the deadline has passed (2.2.7 tests `arenas_expire < now`, so an unforced
++  // call returned once it had, and arena ranges were only purged by a forced collect)
++  if (!force && (arenas_expire == 0 || arenas_expire > now)) return;
+ 
+   const size_t max_arena = mi_atomic_load_acquire(&mi_arena_count);
+   if (max_arena == 0) return;
+ 
+   // allow only one thread to purge at a time
+   static mi_atomic_guard_t purge_guard;
+-  mi_atomic_guard(&purge_guard)
++  // karouka: a forced purge (mi_collect(true)) waits for a purge running on another thread instead of
++  // skipping it, so the arenas are purged when it returns; an unforced one still skips.
++  uintptr_t guard_expected = 0;
++  if (force) {
++    while (!mi_atomic_cas_weak_acq_rel(&purge_guard, &guard_expected, (uintptr_t)1)) {
++      guard_expected = 0;
++      mi_atomic_yield();
++    }
++  }
++  else if (!mi_atomic_cas_strong_acq_rel(&purge_guard, &guard_expected, (uintptr_t)1)) {
++    return;
++  }
+   {
+     // increase global expire: at most one purge per delay cycle
+     mi_atomic_storei64_release(&mi_arenas_purge_expire, now + mi_arena_purge_delay());
+@@ -651,6 +664,7 @@
+       mi_atomic_storei64_release(&mi_arenas_purge_expire, 0);
+     }
+   }
++  mi_atomic_store_release(&purge_guard, (uintptr_t)0);
+ }
+ 
+ 
diff --git a/Meta/CMake/vcpkg/overlay-ports/mimalloc/karouka-reuse-purged-pages.patch b/Meta/CMake/vcpkg/overlay-ports/mimalloc/karouka-reuse-purged-pages.patch
new file mode 100644
index 0000000000..6c3e46a96f
--- /dev/null
+++ b/Meta/CMake/vcpkg/overlay-ports/mimalloc/karouka-reuse-purged-pages.patch
@@ -0,0 +1,35 @@
+karouka: on macOS, mimalloc 2.2.7 decommits with MADV_FREE_REUSABLE but reports
+needs_recommit=false, so a purged range keeps its commit bit and is written again without
+MADV_FREE_REUSE. Those pages stay flagged reusable, and neither the physical footprint nor a
+dirty-page count of mimalloc's VM tag sees them until the kernel reclaims them. Have such a range
+recommitted before reuse, and make the recommit call MADV_FREE_REUSE.
+
+--- a/src/prim/unix/prim.c
++++ b/src/prim/unix/prim.c
+@@ -454,6 +454,13 @@
+     err = errno;
+     unix_mprotect_hint(err);
+   }
++  #if defined(__APPLE__) && defined(MADV_FREE_REUSE)
++  // karouka: a range decommitted with MADV_FREE_REUSABLE (below) is still mapped; tell the kernel we
++  // reuse it so its pages count toward the footprint again (on a range that was never made reusable
++  // this is a no-op). Without it, pages written after a purge stay flagged reusable and the task's
++  // physical footprint does not count them until the kernel reclaims them.
++  if (err == 0) { (void)unix_madvise(start, size, MADV_FREE_REUSE); }
++  #endif
+   return err;
+ }
+ 
+@@ -475,7 +482,11 @@
+     // decommit: use MADV_DONTNEED as it decreases rss immediately (unlike MADV_FREE)
+     err = unix_madvise(start, size, MADV_DONTNEED);
+   #endif
+-  #if !MI_DEBUG && MI_SECURE<=2
++  #if !MI_DEBUG && MI_SECURE<=2 && defined(__APPLE__) && defined(MADV_FREE_REUSABLE)
++    // karouka: the range stays accessible, but have it recommitted before reuse so that
++    // _mi_prim_commit can undo MADV_FREE_REUSABLE with MADV_FREE_REUSE.
++    *needs_recommit = true;
++  #elif !MI_DEBUG && MI_SECURE<=2
+     *needs_recommit = false;
+   #else
+     *needs_recommit = true;
