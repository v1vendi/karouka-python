@@ -0,0 +1,202 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+//! Line-level bidi reordering of a line box's fragments (UAX #9 rule L2).
+//!
+//! The line box merges glyph runs into one fragment only while their resolved direction holds, and a fragment orders
+//! its own runs. Fragments of different elements or fonts are separate units, and the line builder lays them out in
+//! logical order. This pass resolves each fragment's embedding level from its runs' directions and its neighbours
+//! (a simplified W4-W7, N1-N2 and I1-I2 over whole fragments: no explicit embeddings or isolates), reverses the
+//! fragments at each level from the highest down to the lowest odd one, and moves them to their visual offsets.
+//! The fragments keep their logical order in the line box; only their inline offsets change.
+
+use super::*;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Class {
+    L,
+    R,
+    Number,
+    NumberPunctuation(text_chunker::NumberPunctuation),
+    Neutral,
+}
+
+fn classify(fragment: &line_box_fragment::LineBoxFragmentData) -> Class {
+    if fragment.is_atomic_inline || fragment.is_block_ellipsis || fragment.glyphs.is_none() {
+        return Class::Neutral;
+    }
+    let text = fragment.text();
+    if text_chunker::is_number_run(text) {
+        return Class::Number;
+    }
+    if let Some(punctuation) = text_chunker::number_punctuation_run(text) {
+        return Class::NumberPunctuation(punctuation);
+    }
+    match fragment.strong_direction {
+        Some(direction::LTR) => Class::L,
+        Some(direction::RTL) => Class::R,
+        _ => Class::Neutral,
+    }
+}
+
+// The embedding level of each class once resolved, in a paragraph of the given base level (rules I1 and I2).
+fn level(class: Class, base_level: u8) -> u8 {
+    match class {
+        Class::L => base_level + (base_level & 1),
+        Class::R => base_level | 1,
+        Class::Number => (base_level | 1) + 1,
+        Class::NumberPunctuation(_) | Class::Neutral => unreachable!("neutrals are resolved before levels"),
+    }
+}
+
+pub(crate) fn reorder_fragments(line: &mut line_box::LineBoxData) {
+    // A line with an ellipsis was truncated in logical order, and places the ellipsis itself.
+    // FIXME: Truncate reordered lines on their visual end.
+    if line.inline_length_before_block_ellipsis.is_some()
+        || line
+            .fragments
+            .iter()
+            .any(|fragment| fragment.has_text_overflow_ellipsis || fragment.is_fully_truncated)
+    {
+        return;
+    }
+    let base_level = u8::from(line.direction == direction::RTL);
+    let indices: Vec<usize> = (0..line.fragments.len()).collect();
+    if indices.len() < 2 {
+        return;
+    }
+    let mut classes: Vec<Class> = indices
+        .iter()
+        .map(|index| classify(&line.fragments[*index]))
+        .collect();
+    // OPTIMIZATION: Without right-to-left text, a left-to-right line has nothing to reorder (W7 makes its numbers L).
+    if base_level == 0 && !classes.contains(&Class::R) {
+        return;
+    }
+
+    let count = classes.len();
+    // W4, W5: number punctuation joins the numbers next to it.
+    for index in 0..count {
+        let Class::NumberPunctuation(punctuation) = classes[index] else {
+            continue;
+        };
+        let number_before = index > 0 && classes[index - 1] == Class::Number;
+        let number_after = index + 1 < count && classes[index + 1] == Class::Number;
+        let joins = match punctuation {
+            text_chunker::NumberPunctuation::Terminators => number_before || number_after,
+            text_chunker::NumberPunctuation::Separators => number_before && number_after,
+        };
+        classes[index] = if joins { Class::Number } else { Class::Neutral };
+    }
+    // W7: a number after left-to-right text, or at the start of a left-to-right paragraph, is left to right.
+    let embedding_class = if base_level == 0 { Class::L } else { Class::R };
+    let mut last_strong = embedding_class;
+    for class in &mut classes {
+        match *class {
+            Class::L | Class::R => last_strong = *class,
+            Class::Number if last_strong == Class::L => *class = Class::L,
+            _ => {}
+        }
+    }
+    // N1, N2: neutrals between runs of one direction take it (numbers count as right to left), others the paragraph's.
+    let strong = |class: Class| match class {
+        Class::L => Some(Class::L),
+        Class::R | Class::Number => Some(Class::R),
+        Class::NumberPunctuation(_) | Class::Neutral => None,
+    };
+    let mut index = 0;
+    while index < count {
+        if strong(classes[index]).is_some() {
+            index += 1;
+            continue;
+        }
+        let start = index;
+        while index < count && strong(classes[index]).is_none() {
+            index += 1;
+        }
+        let before = if start == 0 {
+            embedding_class
+        } else {
+            strong(classes[start - 1]).unwrap()
+        };
+        let after = if index == count {
+            embedding_class
+        } else {
+            strong(classes[index]).unwrap()
+        };
+        let resolved = if before == after { before } else { embedding_class };
+        classes[start..index].fill(resolved);
+    }
+    let levels: Vec<u8> = classes.iter().map(|class| level(*class, base_level)).collect();
+
+    // The line as tokens: the space before each fragment (inline box edges, text-indent), the fragment, and the space
+    // after the last. A space between two fragments sits at the higher level of its sides, so the edges of an inline
+    // box travel with the box's run; the spaces at the line's ends stay there (they reverse with the line when it is
+    // right to left).
+    struct Token {
+        inline_size: CssPixels,
+        level: u8,
+        fragment: Option<usize>,
+    }
+    let mut tokens = Vec::with_capacity(2 * count + 1);
+    let mut end = CssPixels::default();
+    for (position, fragment_index) in indices.iter().enumerate() {
+        let fragment = &line.fragments[*fragment_index];
+        let level = if position == 0 {
+            base_level
+        } else {
+            levels[position - 1].max(levels[position])
+        };
+        tokens.push(Token {
+            inline_size: fragment.inline_offset - end,
+            level,
+            fragment: None,
+        });
+        tokens.push(Token {
+            inline_size: fragment.inline_length,
+            level: levels[position],
+            fragment: Some(*fragment_index),
+        });
+        end = fragment.inline_offset + fragment.inline_length;
+    }
+    tokens.push(Token {
+        inline_size: line.inline_length - end,
+        level: base_level,
+        fragment: None,
+    });
+
+    // L2: from the highest level down to the lowest odd one, reverse every run at that level or above.
+    let highest_level = tokens.iter().map(|token| token.level).max().unwrap();
+    let lowest_level = tokens.iter().map(|token| token.level).min().unwrap();
+    let lowest_odd_level = lowest_level | 1;
+    for reversal_level in (lowest_odd_level..=highest_level).rev() {
+        let mut index = 0;
+        while index < tokens.len() {
+            if tokens[index].level < reversal_level {
+                index += 1;
+                continue;
+            }
+            let start = index;
+            while index < tokens.len() && tokens[index].level >= reversal_level {
+                index += 1;
+            }
+            tokens[start..index].reverse();
+        }
+    }
+
+    let visual_order = tokens.iter().filter_map(|token| token.fragment);
+    if visual_order.eq(indices.iter().copied()) {
+        return;
+    }
+    let mut inline_offset = CssPixels::default();
+    for token in &tokens {
+        if let Some(fragment_index) = token.fragment {
+            line.fragments[fragment_index].inline_offset = inline_offset;
+        }
+        inline_offset += token.inline_size;
+    }
+    line.is_visually_reordered = true;
+}
