+                computed_index: 0,
+            },
+            geometry.css_width,
+            geometry.css_height,
+            geometry.raster_scale,
+        ));
+        source_paint = BorderImageSourcePaint::Content(ContentSource::Vector {
+            display_list_id,
+            list_size: geometry.list_size,
+        });
