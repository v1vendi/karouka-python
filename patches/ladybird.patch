diff --git a/Libraries/LibWeb/Embedder/LocalCanvas.h b/Libraries/LibWeb/Embedder/LocalCanvas.h
new file mode 100644
index 0000000000..4655836d47
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/LocalCanvas.h
@@ -0,0 +1,47 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Optional.h>
+#include <AK/RefPtr.h>
+#include <LibWeb/Compositor/CompositorHost.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+
+namespace Web::Embedder {
+
+// A canvas 2D context records its drawing into a command stream that a RemoteCanvas2DTransport
+// replays elsewhere; the only transport LibWeb makes comes from the page's CompositorHost, so a
+// page without one has no backing storage: drawing is dropped and getImageData reads zeros. An
+// embedder with no compositor sets a LocalCanvas2DHost: contexts on pages without a
+// CompositorHost then take their transport from it, and each rendering update's present markers
+// are flushed to it (flush_canvas_2d_stream) as they would be to the compositor.
+//
+// A transport or placeholder is made for the page it belongs to, passed as an identity the host may
+// use to drop a page's canvases at once; it is also passed when no script is running (a 2D context
+// restored after contextlost, an OffscreenCanvas's backing storage made at its placeholder commit).
+class WEB_API LocalCanvas2DHost {
+public:
+    virtual ~LocalCanvas2DHost() = default;
+
+    virtual RefPtr<HTML::RemoteCanvas2DTransport> create_canvas_2d_transport(Page const&) = 0;
+    virtual void flush_canvas_2d_stream() = 0;
+
+    // The placeholder canvas of transferControlToOffscreen(), as the compositor keeps it: an id
+    // the canvas element paints with DrawCanvas, which each rendering update's commit points at a
+    // copy of its OffscreenCanvas's presented pixels (none: the placeholder paints nothing).
+    virtual Optional<Compositor::PlaceholderCanvasLink> allocate_placeholder_canvas(Page const&) = 0;
+    virtual void release_placeholder_canvas(Compositing::CanvasId) = 0;
+    virtual void commit_placeholder_canvas(Compositor::PlaceholderCanvasLink, Optional<Compositing::CanvasId> source_canvas_id, Gfx::IntSize, bool origin_clean) = 0;
+    virtual Compositor::PlaceholderCanvasPixels read_placeholder_canvas_pixels(Compositing::CanvasId, Gfx::IntRect) = 0;
+};
+
+// Not owned; null (the default) leaves canvases without a CompositorHost unbacked.
+WEB_API void set_local_canvas_2d_host(LocalCanvas2DHost*);
+WEB_API LocalCanvas2DHost* local_canvas_2d_host();
+
+}
diff --git a/Libraries/LibWeb/Embedder/Prune/ContentBlocker.cmake b/Libraries/LibWeb/Embedder/Prune/ContentBlocker.cmake
new file mode 100644
index 0000000000..81a0e0f384
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/ContentBlocker.cmake
@@ -0,0 +1,8 @@
+# karouka: the content blocker's Rust engine (ContentBlocker/Rust: the adblock crate, with psl, regex,
+# aho-corasick, idna and flatbuffers behind it). An embedder with no network has nothing to block, and
+# never loads a filter list. Loader/ContentBlocker.cpp stays, without its engine: nothing is filtered,
+# there is no cosmetic style sheet, and setting rules other than none fails. The callers ask it, so they
+# need no guards. This is not a family: the definition is on ContentBlocker.cpp alone, so turning it on
+# recompiles one file, and LibWeb's CMakeLists.txt leaves libweb_content_blocker_rust out of the link.
+set(LIBWEB_PRUNE_CONTENTBLOCKER ON)
+set_property(SOURCE Loader/ContentBlocker.cpp APPEND PROPERTY COMPILE_DEFINITIONS LIBWEB_PRUNE_CONTENTBLOCKER)
