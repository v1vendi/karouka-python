diff --git a/Meta/CMake/vcpkg/overlay-ports/mimalloc/portfile.cmake b/Meta/CMake/vcpkg/overlay-ports/mimalloc/portfile.cmake
new file mode 100644
index 0000000000..42452551fb
--- /dev/null
+++ b/Meta/CMake/vcpkg/overlay-ports/mimalloc/portfile.cmake
@@ -0,0 +1,65 @@
+# karouka: vcpkg's mimalloc 2.2.7#0 port (vcpkg git-tree 5b9c09b6d159), plus
+# karouka-reuse-purged-pages.patch: on macOS, recommit purged pages with MADV_FREE_REUSE before
+# reuse so the physical footprint counts them, and karouka-purge-expired-arenas.patch:
+# purge arena ranges once their deadline passes, not only in a forced collect.
+
+vcpkg_from_github(
+    OUT_SOURCE_PATH SOURCE_PATH
+    REPO microsoft/mimalloc
+    REF "v${VERSION}"
+    SHA512 19f5481c98822c6a279e2f2d26d6c54918e18bcafd515a76ca3a3845f3a5e599236ea042f9cadaf793dce0c1ede347d76cc2fc5503094288362a78034d4d8f71
+    HEAD_REF master
+    PATCHES
+        pkgconfig-cxx.diff
+        karouka-reuse-purged-pages.patch
+        karouka-purge-expired-arenas.patch
+)
+
