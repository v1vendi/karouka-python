+    // karouka: a shader() image with arguments paints its source's decoded data bound to them.
+    auto const* shader = as_if<Embedder::ShaderDecodedImageData>(decoded_image_data.ptr());
+    if (!shader || !m_image_style_value.rust_style_value_data()->image.shader_arguments.pointer)
+        return decoded_image_data;
+    // A canvas input resolves to the canvas's surface as it is now (another context, or a canvas tainted since,
+    // gives other arguments), so the arguments are resolved on each ask and a change binds them anew.
+    auto arguments = shader_arguments_from_rust_data(m_image_style_value.rust_style_value_data()->image.shader_arguments, m_document.ptr().ptr(), Embedder::image_client_element(this));
+    auto const* bound_data = as_if<Embedder::ShaderDecodedImageData>(m_shader_image_data_with_arguments.ptr());
+    if (m_shader_image_data_bound != shader || !bound_data || bound_data->arguments() != arguments.span()) {
+        GC::Ref<HTML::DecodedImageData> bound = shader->with_arguments(move(arguments));
+        m_shader_image_data_with_arguments = GC::Root<HTML::DecodedImageData> { bound };
+        m_shader_image_data_bound = shader;
+    }
+    return m_shader_image_data_with_arguments.ptr();
 }
 
