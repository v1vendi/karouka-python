index 0000000000..2544c1525f
--- /dev/null
+++ b/Libraries/LibCrypto/Hash/CommonCryptoDigest.cpp
@@ -0,0 +1,120 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// karouka: OpenSSL's EVP digest calls, as far as OpenSSLHashFunction<> makes them, over Apple's
+// CommonCrypto (a system library). See CommonCryptoDigest.h.
+
+#include <AK/StdLibExtras.h>
+#include <AK/kmalloc.h>
+#include <LibCrypto/Hash/CommonCryptoDigest.h>
+
+// CC_SHA1 is deprecated as a cryptographic primitive. LibCrypto's SHA1 only keys LibHTTP's memory
+// cache (LibHTTP/Cache/Utilities.cpp) in a build that uses this file.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+#include <CommonCrypto/CommonDigest.h>
+
+namespace {
+
+union DigestState {
+    CC_SHA1_CTX sha1;
+    CC_SHA256_CTX sha256;
+    CC_SHA512_CTX sha512;
+};
+
+}
+
+extern "C" {
+
+struct evp_md_st {
+    int (*init)(DigestState*);
+    int (*update)(DigestState*, void const*, CC_LONG);
+    int (*final)(unsigned char*, DigestState*);
+    unsigned int digest_size;
+};
+
+struct evp_md_ctx_st {
+    EVP_MD const* type { nullptr };
+    DigestState state;
+};
+
+static constexpr evp_md_st s_sha1 {
+    [](DigestState* state) { return CC_SHA1_Init(&state->sha1); },
+    [](DigestState* state, void const* data, CC_LONG length) { return CC_SHA1_Update(&state->sha1, data, length); },
+    [](unsigned char* digest, DigestState* state) { return CC_SHA1_Final(digest, &state->sha1); },
+    CC_SHA1_DIGEST_LENGTH,
+};
+
+static constexpr evp_md_st s_sha256 {
+    [](DigestState* state) { return CC_SHA256_Init(&state->sha256); },
+    [](DigestState* state, void const* data, CC_LONG length) { return CC_SHA256_Update(&state->sha256, data, length); },
+    [](unsigned char* digest, DigestState* state) { return CC_SHA256_Final(digest, &state->sha256); },
+    CC_SHA256_DIGEST_LENGTH,
+};
+
+static constexpr evp_md_st s_sha384 {
+    [](DigestState* state) { return CC_SHA384_Init(&state->sha512); },
+    [](DigestState* state, void const* data, CC_LONG length) { return CC_SHA384_Update(&state->sha512, data, length); },
+    [](unsigned char* digest, DigestState* state) { return CC_SHA384_Final(digest, &state->sha512); },
+    CC_SHA384_DIGEST_LENGTH,
+};
+
+static constexpr evp_md_st s_sha512 {
+    [](DigestState* state) { return CC_SHA512_Init(&state->sha512); },
+    [](DigestState* state, void const* data, CC_LONG length) { return CC_SHA512_Update(&state->sha512, data, length); },
+    [](unsigned char* digest, DigestState* state) { return CC_SHA512_Final(digest, &state->sha512); },
+    CC_SHA512_DIGEST_LENGTH,
+};
+
+EVP_MD const* EVP_sha1() { return &s_sha1; }
+EVP_MD const* EVP_sha256() { return &s_sha256; }
+EVP_MD const* EVP_sha384() { return &s_sha384; }
+EVP_MD const* EVP_sha512() { return &s_sha512; }
+
+EVP_MD_CTX* EVP_MD_CTX_new()
+{
+    return new (nothrow) evp_md_ctx_st;
+}
+
+void EVP_MD_CTX_free(EVP_MD_CTX* context)
+{
+    delete context;
+}
+
+int EVP_DigestInit_ex(EVP_MD_CTX* context, EVP_MD const* type, ENGINE*)
+{
+    context->type = type;
+    return type->init(&context->state);
+}
+
+int EVP_DigestUpdate(EVP_MD_CTX* context, void const* data, size_t length)
+{
+    auto const* bytes = static_cast<unsigned char const*>(data);
+    // CC_LONG is 32 bits.
+    while (length > 0) {
+        auto chunk = static_cast<CC_LONG>(min<size_t>(length, 1u << 30));
+        if (context->type->update(&context->state, bytes, chunk) != 1)
+            return 0;
+        bytes += chunk;
+        length -= chunk;
+    }
+    return 1;
+}
+
+int EVP_DigestFinal_ex(EVP_MD_CTX* context, unsigned char* digest, unsigned int* digest_size)
+{
+    if (digest_size)
+        *digest_size = context->type->digest_size;
+    return context->type->final(digest, &context->state);
+}
+
+int EVP_MD_CTX_copy_ex(EVP_MD_CTX* destination, EVP_MD_CTX const* source)
+{
+    *destination = *source;
+    return 1;
+}
+
+}
+
+#pragma clang diagnostic pop
