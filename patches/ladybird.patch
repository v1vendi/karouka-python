@@ -0,0 +1,65 @@
+/*
+ * karouka: no-playback stand-ins for the LibMedia entry points that LibWeb, LibCompositing and
+ * LibMediaClient reference when LibMedia is built with LADYBIRD_MEDIA_STUB. Nothing here decodes:
+ * codec support queries answer "no", the audio converter cannot be created, and the IPC
+ * serializers refuse (there is no MediaServer to talk to).
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibIPC/Decoder.h>
+#include <LibIPC/Encoder.h>
+#include <LibMedia/FFmpeg/FFmpegAudioConverter.h>
+#include <LibMedia/MediaSourceExtensions/ISOBMFFByteStreamParser.h>
+#include <LibMedia/MediaSourceExtensions/SourceBufferProcessor.h>
+#include <LibMedia/MediaSourceExtensions/WebMByteStreamParser.h>
+#include <LibMedia/MediaSupport.h>
+
+namespace Media {
+
+Optional<CodecID> codec_implied_by_file_container(ContainerMimeType)
+{
+    return {};
+}
+
+}
+
+namespace Media::MediaSourceExtensions {
+
+bool WebMByteStreamParser::supports_codec(StringView, Media::CodecID) { return false; }
+bool ISOBMFFByteStreamParser::supports_codec(StringView, Media::CodecID) { return false; }
+
+}
+
+namespace Media::FFmpeg {
+
+FFmpegAudioConverter::FFmpegAudioConverter() = default;
+FFmpegAudioConverter::~FFmpegAudioConverter() = default;
+ErrorOr<NonnullOwnPtr<FFmpegAudioConverter>> FFmpegAudioConverter::try_create() { return Error::from_string_literal("Media playback is not built in"); }
+ErrorOr<void> FFmpegAudioConverter::set_output_sample_specification(Audio::SampleSpecification) { return Error::from_string_literal("Media playback is not built in"); }
+ErrorOr<void> FFmpegAudioConverter::push_block(AudioBlock const&) { return Error::from_string_literal("Media playback is not built in"); }
+DecoderErrorOr<void> FFmpegAudioConverter::retrieve_block(AudioBlock&) { return DecoderError::not_implemented(); }
+void FFmpegAudioConverter::signal_end_of_stream() { }
+void FFmpegAudioConverter::flush() { }
+
+}
+
+namespace IPC {
+
+#define KAROUKA_NO_MEDIA_IPC(Type)                                                                  \
+    template<>                                                                                      \
+    ErrorOr<void> encode(Encoder&, Type const&)                                                     \
+    {                                                                                               \
+        return Error::from_string_literal("Media IPC is not built in");                             \
+    }                                                                                               \
+    template<>                                                                                      \
+    ErrorOr<Type> decode(Decoder&)                                                                  \
+    {                                                                                               \
+        return Error::from_string_literal("Media IPC is not built in");                             \
+    }
+
+KAROUKA_NO_MEDIA_IPC(Media::DecoderCapabilities)
+KAROUKA_NO_MEDIA_IPC(Media::MediaSupportInfo)
+KAROUKA_NO_MEDIA_IPC(Media::MediaSourceExtensions::PublishedState)
+
+}
